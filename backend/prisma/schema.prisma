generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Game {
  id         String   @id @default(cuid())
  state      String   @default("idle")
  initialFen String
  currentFen String
  createdAt  DateTime @default(now())
  finishedAt DateTime?

  whitePlayerUsername String?
  blackPlayerUsername String?

  whitePlayer User? @relation("WhitePlayer", fields: [whitePlayerUsername], references: [username])
  blackPlayer User? @relation("BlackPlayer", fields: [blackPlayerUsername], references: [username])

  moves Move[]
}

model Move {
  id         Int      @id @default(autoincrement())
  from       String
  to         String
  promotion  String?
  moveNumber Int
  san        String
  uci        String
  fenAfter   String
  createdAt  DateTime @default(now())

  gameId String
  game   Game   @relation(fields: [gameId], references: [id])

  @@unique([gameId, moveNumber])
}

model User {
  username     String @id
  email        String @unique
  passwordhash String

  gamesAsWhite Game[] @relation("WhitePlayer")
  gamesAsBlack Game[] @relation("BlackPlayer")
}