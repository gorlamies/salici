generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameState {
  ready
  running
  aborted
  white_win
  black_win
  white_resigned
  black_resigned
  white_timeout
  black_timeout
  draw
  stalemate
  insufficient_material
  threefold_repetition
  fivefold_repetition
  fifty_move_rule
  seventy_five_move_rule
}

enum TimeCategory {
  bullet
  blitz
  rapid
  classical
  unlimited
}

model Game {
  id         String   @id @default(cuid())
  state      GameState @default(ready)
  initialFen String
  currentFen String
  createdAt  DateTime @default(now())
  finishedAt DateTime?

  whitePlayerUsername String?
  blackPlayerUsername String?

  whitePlayer User? @relation("WhitePlayer", fields: [whitePlayerUsername], references: [username])
  blackPlayer User? @relation("BlackPlayer", fields: [blackPlayerUsername], references: [username])

  moves Move[]

  initialTimeMs Int?
  incrementMs Int?
  whiteRemainingMs Int?
  blackRemainingMs Int?
  turnStartedAt DateTime?

  timeCategory TimeCategory @default(unlimited)
  whiteRatingBefore Int?
  whiteRatingAfter Int?
  blackRatingBefore Int?
  blackRatingAfter Int?

  @@index([whitePlayerUsername, createdAt])
  @@index([blackPlayerUsername, createdAt])
}

model Move {
  id         Int      @id @default(autoincrement())
  from       String
  to         String
  promotion  String?
  moveNumber Int
  san        String
  uci        String
  fenAfter   String
  createdAt  DateTime @default(now())

  gameId String
  game   Game   @relation(fields: [gameId], references: [id])

  remainingMsAfter Int?

  @@unique([gameId, moveNumber])
}

model User {
  username     String @id
  email        String @unique
  passwordhash String

  createdAt DateTime @default(now())
  closedAt DateTime?
  hideOnlineStatus Boolean @default(false)

  gamesAsWhite Game[] @relation("WhitePlayer")
  gamesAsBlack Game[] @relation("BlackPlayer")

  follower Follow[] @relation("Followed")
  followed Follow[] @relation("Follower")
  ratings Rating[]
}

model Follow {
  followerUsername String
  followedUsername String
  createdAt DateTime @default(now())

  followed User @relation("Followed", fields: [followedUsername], references: [username], onDelete: Cascade)
  follower User @relation("Follower", fields: [followerUsername], references: [username], onDelete: Cascade)

  @@id([followerUsername, followedUsername])
  @@index([followedUsername])
}

model Rating {
  username String
  timeCategory TimeCategory
  rating Float @default(1500)
  deviation Float @default(350)
  volatility Float @default(0.06)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [username], references: [username], onDelete: Cascade)

  @@id([username, timeCategory])
}